<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github-yuchia" value="https://nuget.pkg.github.com/YuChia-Wei/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
    <packageSource key="github-yuchia"><package pattern="ArchPrecept.*" /></packageSource>
  </packageSourceMapping>
</configuration>
